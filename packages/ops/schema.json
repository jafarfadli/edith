{
  "$defs": {
    "AnnotAdd": {
      "additionalProperties": false,
      "description": "A native PDF annotation: text markup over `quads` (one rect per line, horizontal text) or a\nsticky note whose icon's top-left corner is `point`.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "pageKey": {
          "pattern": "^(o\\d+|u[0-9A-Za-z-]+)$",
          "title": "Pagekey",
          "type": "string"
        },
        "type": {
          "const": "annot.add",
          "title": "Type",
          "type": "string"
        },
        "kind": {
          "enum": [
            "highlight",
            "underline",
            "strike",
            "note"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quads": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Rect"
              },
              "maxItems": 2000,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quads"
        },
        "point": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point"
        },
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        }
      },
      "required": [
        "id",
        "pageKey",
        "type",
        "kind",
        "color"
      ],
      "title": "AnnotAdd",
      "type": "object"
    },
    "BlankSize": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 14400,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 14400,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "BlankSize",
      "type": "object"
    },
    "BlankSrc": {
      "additionalProperties": false,
      "properties": {
        "blank": {
          "$ref": "#/$defs/BlankSize"
        }
      },
      "required": [
        "blank"
      ],
      "title": "BlankSrc",
      "type": "object"
    },
    "BundledFont": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bundled",
          "default": "bundled",
          "title": "Kind",
          "type": "string"
        },
        "family": {
          "title": "Family",
          "type": "string"
        },
        "bold": {
          "default": false,
          "title": "Bold",
          "type": "boolean"
        },
        "italic": {
          "default": false,
          "title": "Italic",
          "type": "boolean"
        }
      },
      "required": [
        "family"
      ],
      "title": "BundledFont",
      "type": "object"
    },
    "CropRect": {
      "additionalProperties": false,
      "description": "Visible part of a page, in the page's own coordinates (unrotated, relative to its source CropBox).",
      "properties": {
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "w": {
          "minimum": 1,
          "title": "W",
          "type": "number"
        },
        "h": {
          "minimum": 1,
          "title": "H",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "CropRect",
      "type": "object"
    },
    "DocSrc": {
      "additionalProperties": false,
      "properties": {
        "doc": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Doc",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        }
      },
      "required": [
        "doc",
        "index"
      ],
      "title": "DocSrc",
      "type": "object"
    },
    "ExportRequest": {
      "additionalProperties": false,
      "properties": {
        "ops": {
          "items": {
            "discriminator": {
              "mapping": {
                "annot.add": "#/$defs/AnnotAdd",
                "form.set": "#/$defs/FormSet",
                "image.add": "#/$defs/ImageAdd",
                "ink.add": "#/$defs/InkAdd",
                "link.add": "#/$defs/LinkAdd",
                "pages.layout": "#/$defs/PagesLayout",
                "redact.add": "#/$defs/RedactAdd",
                "shape.add": "#/$defs/ShapeAdd",
                "signature.add": "#/$defs/SignatureAdd",
                "stamp.add": "#/$defs/StampAdd",
                "symbol.add": "#/$defs/SymbolAdd",
                "text.add": "#/$defs/TextAdd",
                "text.edit": "#/$defs/TextEdit",
                "text.ocr_edit": "#/$defs/TextOcrEdit",
                "whiteout.add": "#/$defs/WhiteoutAdd"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextAdd"
              },
              {
                "$ref": "#/$defs/TextEdit"
              },
              {
                "$ref": "#/$defs/TextOcrEdit"
              },
              {
                "$ref": "#/$defs/ImageAdd"
              },
              {
                "$ref": "#/$defs/ShapeAdd"
              },
              {
                "$ref": "#/$defs/InkAdd"
              },
              {
                "$ref": "#/$defs/WhiteoutAdd"
              },
              {
                "$ref": "#/$defs/RedactAdd"
              },
              {
                "$ref": "#/$defs/SignatureAdd"
              },
              {
                "$ref": "#/$defs/StampAdd"
              },
              {
                "$ref": "#/$defs/SymbolAdd"
              },
              {
                "$ref": "#/$defs/LinkAdd"
              },
              {
                "$ref": "#/$defs/AnnotAdd"
              },
              {
                "$ref": "#/$defs/FormSet"
              },
              {
                "$ref": "#/$defs/PagesLayout"
              }
            ]
          },
          "maxItems": 5000,
          "title": "Ops",
          "type": "array"
        },
        "flatten_forms": {
          "default": false,
          "title": "Flatten Forms",
          "type": "boolean"
        },
        "filename": {
          "default": "document.pdf",
          "maxLength": 200,
          "title": "Filename",
          "type": "string"
        },
        "paragraphs_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraphs Version"
        }
      },
      "required": [
        "ops"
      ],
      "title": "ExportRequest",
      "type": "object"
    },
    "FormSet": {
      "additionalProperties": false,
      "description": "Value of AcroForm field `fieldName` (every widget of that name): text/combo/list -> the string,\ncheckbox -> bool, radio -> the on-state name of the chosen button (or \"Off\"). `doc`: a field of that\nimported PDF, named as in its own structure (the export may rename it when the name is taken); none =\nthe edited PDF.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "form.set",
          "title": "Type",
          "type": "string"
        },
        "fieldName": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Fieldname",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        },
        "doc": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc"
        }
      },
      "required": [
        "id",
        "type",
        "fieldName",
        "value"
      ],
      "title": "FormSet",
      "type": "object"
    },
    "ImageAdd": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "pageKey": {
          "pattern": "^(o\\d+|u[0-9A-Za-z-]+)$",
          "title": "Pagekey",
          "type": "string"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "maximum": 360,
          "minimum": -360,
          "title": "Rotation",
          "type": "number"
        },
        "type": {
          "const": "image.add",
          "title": "Type",
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rect"
        },
        "assetId": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Assetid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "pageKey",
        "type",
        "rect",
        "assetId"
      ],
      "title": "ImageAdd",
      "type": "object"
    },
    "InkAdd": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "pageKey": {
          "pattern": "^(o\\d+|u[0-9A-Za-z-]+)$",
          "title": "Pagekey",
          "type": "string"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "type": {
          "const": "ink.add",
          "title": "Type",
          "type": "string"
        },
        "paths": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "id",
        "pageKey",
        "type",
        "paths",
        "color",
        "width"
      ],
      "title": "InkAdd",
      "type": "object"
    },
    "LayoutLine": {
      "additionalProperties": false,
      "description": "`source` (text.edit only): the index of the original paragraph line this line repeats unchanged (same\ntext, styles and line break, in place). The bake then keeps that line's original glyphs: it neither redacts\nnor redraws it. If the line no longer matches the original, the bake redraws it from `segments`.\n`prefix` (text.edit only, M5d): the line is an edited original line whose first words stay as they were. The\nbake keeps their original glyphs and redraws the rest of the line, from the original x of its first other\nword on; if the prefix no longer matches the original, it redraws the whole line from `segments`.",
      "properties": {
        "baseline": {
          "title": "Baseline",
          "type": "number"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "title": "Segments",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "prefix": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinePrefix"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "baseline",
        "segments"
      ],
      "title": "LayoutLine",
      "type": "object"
    },
    "LayoutPage": {
      "additionalProperties": false,
      "description": "`src.doc` is the edited document or another uploaded one (an imported PDF).",
      "properties": {
        "pageKey": {
          "pattern": "^(o\\d+|u[0-9A-Za-z-]+)$",
          "title": "Pagekey",
          "type": "string"
        },
        "src": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocSrc"
            },
            {
              "$ref": "#/$defs/BlankSrc"
            }
          ],
          "title": "Src"
        },
        "rotate": {
          "default": 0,
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Rotate",
          "type": "integer"
        },
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/CropRect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "pageKey",
        "src"
      ],
      "title": "LayoutPage",
      "type": "object"
    },
    "LinePrefix": {
      "additionalProperties": false,
      "description": "The first `segments` segments of a layout line repeat the first words of original line `source` unchanged,\nin place (see LayoutLine.prefix).",
      "properties": {
        "source": {
          "minimum": 0,
          "title": "Source",
          "type": "integer"
        },
        "segments": {
          "minimum": 1,
          "title": "Segments",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "segments"
      ],
      "title": "LinePrefix",
      "type": "object"
    },
    "LinkAdd": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "pageKey": {
          "pattern": "^(o\\d+|u[0-9A-Za-z-]+)$",
          "title": "Pagekey",
          "type": "string"
        },
        "type": {
          "const": "link.add",
          "title": "Type",
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rect"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/UrlTarget"
            },
            {
              "$ref": "#/$defs/PageTarget"
            }
          ],
          "title": "Target"
        }
      },
      "required": [
        "id",
        "pageKey",
        "type",
        "rect",
        "target"
      ],
      "title": "LinkAdd",
      "type": "object"
    },
    "OriginalFont": {
      "additionalProperties": false,
      "description": "A font embedded in an uploaded PDF (`ref` from GET /documents/{id}/text), reused as is. `doc`: the\nimported PDF it comes from (xref-based refs are only unique per document); none = the edited PDF.",
      "properties": {
        "kind": {
          "const": "original",
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "pattern": "^f\\d+$",
          "title": "Ref",
          "type": "string"
        },
        "doc": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "OriginalFont",
      "type": "object"
    },
    "PageTarget": {
      "additionalProperties": false,
      "properties": {
        "pageKey": {
          "pattern": "^(o\\d+|u[0-9A-Za-z-]+)$",
          "title": "Pagekey",
          "type": "string"
        }
      },
      "required": [
        "pageKey"
      ],
      "title": "PageTarget",
      "type": "object"
    },
    "PagesLayout": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "pages.layout",
          "title": "Type",
          "type": "string"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/LayoutPage"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "pages"
      ],
      "title": "PagesLayout",
      "type": "object"
    },
    "Rect": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "w": {
          "minimum": 0,
          "title": "W",
          "type": "number"
        },
        "h": {
          "minimum": 0,
          "title": "H",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Rect",
      "type": "object"
    },
    "RedactAdd": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "pageKey": {
          "pattern": "^(o\\d+|u[0-9A-Za-z-]+)$",
          "title": "Pagekey",
          "type": "string"
        },
        "type": {
          "const": "redact.add",
          "title": "Type",
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rect"
        },
        "fill": {
          "default": "black",
          "enum": [
            "black",
            "white"
          ],
          "title": "Fill",
          "type": "string"
        }
      },
      "required": [
        "id",
        "pageKey",
        "type",
        "rect"
      ],
      "title": "RedactAdd",
      "type": "object"
    },
    "RenderPageRequest": {
      "additionalProperties": false,
      "properties": {
        "pageKey": {
          "pattern": "^(o\\d+|u[0-9A-Za-z-]+)$",
          "title": "Pagekey",
          "type": "string"
        },
        "ops": {
          "items": {
            "discriminator": {
              "mapping": {
                "annot.add": "#/$defs/AnnotAdd",
                "form.set": "#/$defs/FormSet",
                "image.add": "#/$defs/ImageAdd",
                "ink.add": "#/$defs/InkAdd",
                "link.add": "#/$defs/LinkAdd",
                "pages.layout": "#/$defs/PagesLayout",
                "redact.add": "#/$defs/RedactAdd",
                "shape.add": "#/$defs/ShapeAdd",
                "signature.add": "#/$defs/SignatureAdd",
                "stamp.add": "#/$defs/StampAdd",
                "symbol.add": "#/$defs/SymbolAdd",
                "text.add": "#/$defs/TextAdd",
                "text.edit": "#/$defs/TextEdit",
                "text.ocr_edit": "#/$defs/TextOcrEdit",
                "whiteout.add": "#/$defs/WhiteoutAdd"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextAdd"
              },
              {
                "$ref": "#/$defs/TextEdit"
              },
              {
                "$ref": "#/$defs/TextOcrEdit"
              },
              {
                "$ref": "#/$defs/ImageAdd"
              },
              {
                "$ref": "#/$defs/ShapeAdd"
              },
              {
                "$ref": "#/$defs/InkAdd"
              },
              {
                "$ref": "#/$defs/WhiteoutAdd"
              },
              {
                "$ref": "#/$defs/RedactAdd"
              },
              {
                "$ref": "#/$defs/SignatureAdd"
              },
              {
                "$ref": "#/$defs/StampAdd"
              },
              {
                "$ref": "#/$defs/SymbolAdd"
              },
              {
                "$ref": "#/$defs/LinkAdd"
              },
              {
                "$ref": "#/$defs/AnnotAdd"
              },
              {
                "$ref": "#/$defs/FormSet"
              },
              {
                "$ref": "#/$defs/PagesLayout"
              }
            ]
          },
          "maxItems": 5000,
          "title": "Ops",
          "type": "array"
        },
        "paragraphs_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraphs Version"
        }
      },
      "required": [
        "pageKey",
        "ops"
      ],
      "title": "RenderPageRequest",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "description": "`hScale`, `charSpacing`, `wordSpacing`: the original PDF's horizontal scaling (Tz), character spacing (Tc,\nTJ condensing) and word spacing (Tw, per-word placement), measured by GET /text for original text. The pen\nadvance of a character is `hScale \u00b7 advance \u00b7 size + charSpacing (+ wordSpacing for \" \")`, in pt; the glyph\nis drawn `hScale` times as wide. Clients split a run with spacing into one segment per character\n(`charSpacing`) or per word and space (`wordSpacing`), so a segment's own glyphs only need `hScale`.\n`underlineTop`, `strikeTop`, `decorThickness` (\u00d7 size; top edge relative to the baseline, down positive) and\n`decorColor`: where, how thick and in which colour the original PDF drew a run's underline / strikethrough (GET\n/text, original text); absent = the defaults of bake/text.py (UNDERLINE_TOP, STRIKE_TOP, DECOR_THICKNESS, the\ntext colour).",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "font": {
          "anyOf": [
            {
              "$ref": "#/$defs/BundledFont"
            },
            {
              "$ref": "#/$defs/OriginalFont"
            }
          ],
          "title": "Font"
        },
        "size": {
          "exclusiveMinimum": 0,
          "maximum": 500,
          "title": "Size",
          "type": "number"
        },
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "bgColor": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bgcolor"
        },
        "underline": {
          "default": false,
          "title": "Underline",
          "type": "boolean"
        },
        "strike": {
          "default": false,
