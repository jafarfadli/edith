    "TextEdit": {
      "additionalProperties": false,
      "description": "Replaces original paragraph `paragraphId` of the page's source page with `box`. `decorV` 1: the box's runs carry\nthe original's drawn decorations as GET /text reports them (Run.underline / strike / bgColor and their geometry):\nthe bake removes the decoration marks of the lines it redraws and keeps a line only with the same decorations.\nAbsent (a client or draft from before): the marks stay where they are and decorations are not compared.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "pageKey": {
          "pattern": "^(o\\d+|u[0-9A-Za-z-]+)$",
          "title": "Pagekey",
          "type": "string"
        },
        "type": {
          "const": "text.edit",
          "title": "Type",
          "type": "string"
        },
        "paragraphId": {
          "pattern": "^g\\d+$",
          "title": "Paragraphid",
          "type": "string"
        },
        "box": {
          "$ref": "#/$defs/TextBox"
        },
        "decorV": {
          "anyOf": [
            {
              "const": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decorv"
        }
      },
      "required": [
        "id",
        "pageKey",
        "type",
        "paragraphId",
        "box"
      ],
      "title": "TextEdit",
      "type": "object"
    },
    "TextOcrEdit": {
      "additionalProperties": false,
      "description": "Replaces a paragraph OCR read in a picture of text (POST /documents/{id}/pages/{n}/ocr, M5d). `cover` is painted\nwith `coverColor` (the picture's own background there) over the page's original content, under every drawn object\n\u2014 as a text.edit's original glyphs go \u2014 and `box` is drawn in the op's stacking order. Self-contained: the bake\nreads neither the OCR result nor the source page, so a draft restores and exports without OCR running again.\n`paragraphId` names the OCR paragraph (ocr0, ocr1, \u2026), or the hidden paragraph whose picture it rewrites (hg1 for\ng1: invisible text over a picture of it, its print measured by GET .../pages/{n}/hidden-text) for the client: one op\nper page and id. `covers`: one rect per line of the paragraph (its words' ink, padded): what is painted when given,\nso a short last line leaves the corner beside it alone; `cover` is their bounding box (all that is painted without\n`covers`).",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "pageKey": {
          "pattern": "^(o\\d+|u[0-9A-Za-z-]+)$",
          "title": "Pagekey",
          "type": "string"
        },
        "type": {
          "const": "text.ocr_edit",
          "title": "Type",
          "type": "string"
        },
        "paragraphId": {
          "pattern": "^(?:ocr|hg)\\d+$",
          "title": "Paragraphid",
          "type": "string"
        },
        "cover": {
          "$ref": "#/$defs/Rect"
        },
        "covers": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Rect"
              },
              "maxItems": 500,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covers"
        },
        "coverColor": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Covercolor",
          "type": "string"
        },
        "box": {
          "$ref": "#/$defs/TextBox"
        }
      },
      "required": [
        "id",
        "pageKey",
        "type",
        "paragraphId",
        "cover",
        "coverColor",
        "box"
      ],
      "title": "TextOcrEdit",
      "type": "object"
    },
